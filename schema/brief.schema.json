{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diode/brief.schema.json",
  "title": "Diode brief (format 1)",
  "description": "안쪽 (사내 LLM) 이 쓰고 다이오드가 펼쳐 바깥 (Claude) 으로 보내는 닫힌 형식. 규칙의 정본은 docs/SPEC.md › 02. 이 파일은 D1 (형식) 의 기계 판정에 쓴다 — 숫자 · 사전 · 꼴 · 덩어리 검사는 D2–D5 가 따로 한다.",
  "type": "object",
  "required": ["format", "kind", "data_class"],
  "properties": {
    "format": {"const": 1},
    "kind": {"enum": ["plan", "ui", "lib", "report"]},
    "data_class": {"enum": ["synthetic", "real"]},
    "route": {"$ref": "#/$defs/route"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"enum": ["plan", "ui"]}}},
     "then": {"required": ["goal", "ask"],
              "properties": {"format": true, "kind": true, "data_class": true, "route": true,
                             "goal": {"$ref": "#/$defs/text300"},
                             "context": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/text200"}},
                             "entities": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/entity"}},
                             "fields": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/field"}},
                             "constraints": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/text120"}},
                             "ask": {"$ref": "#/$defs/text200"}},
              "additionalProperties": false}},
    {"if": {"properties": {"kind": {"const": "lib"}}},
     "then": {"required": ["library", "goal", "ask"],
              "properties": {"format": true, "kind": true, "data_class": true, "route": true,
                             "library": {"type": "object", "required": ["name"], "additionalProperties": false,
                                         "properties": {"name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$"},
                                                        "version": {"type": "string", "pattern": "^[0-9][0-9A-Za-z.\\-+]{0,19}$"}}},
                             "language": {"const": "python"},
                             "goal": {"$ref": "#/$defs/text300"},
                             "repro": {"type": "string", "maxLength": 4000},
                             "error": {"type": "object", "additionalProperties": false, "required": ["type"],
                                       "properties": {"type": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,59}$"},
                                                      "message": {"$ref": "#/$defs/text200"}}},
                             "ask": {"$ref": "#/$defs/text200"}},
              "additionalProperties": false}},
    {"if": {"properties": {"kind": {"const": "report"}}},
     "then": {"required": ["job", "status", "summary"],
              "properties": {"format": true, "kind": true, "data_class": true, "route": true,
                             "job": {"$ref": "#/$defs/job"},
                             "status": {"enum": ["done", "blocked", "question"]},
                             "counts": {"type": "object", "additionalProperties": false,
                                        "properties": {"changed_files": {"$ref": "#/$defs/count9999"},
                                                       "tests_passed": {"$ref": "#/$defs/count9999"},
                                                       "tests_failed": {"$ref": "#/$defs/count9999"},
                                                       "tests_skipped": {"$ref": "#/$defs/count9999"}}},
                             "summary": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/text200"}},
                             "entities": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/entity"}},
                             "questions": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/text200"}}},
              "additionalProperties": false}}
  ],
  "$defs": {
    "token": {"type": "string", "pattern": "^PH_[2-9A-HJKMNP-TV-Z]{4}$"},
    "job": {"type": "string", "pattern": "^J-[0-9]{4}$"},
    "count9999": {"type": "integer", "minimum": 0, "maximum": 9999},
    "text120": {"type": "string", "minLength": 1, "maxLength": 120},
    "text200": {"type": "string", "minLength": 1, "maxLength": 200},
    "text300": {"type": "string", "minLength": 1, "maxLength": 300},
    "route": {"type": "object", "additionalProperties": false,
              "properties": {"difficulty": {"enum": ["simple", "normal", "hard", "critical"]},
                             "effort": {"enum": ["auto", "low", "medium", "high", "xhigh", "max"]}}},
    "entity": {"type": "object", "required": ["token", "type"], "additionalProperties": false,
               "properties": {"token": {"$ref": "#/$defs/token"},
                              "type": {"enum": ["화면", "항목", "단계", "표", "역할", "파일"]},
                              "note": {"$ref": "#/$defs/text120"}}},
    "field": {"type": "object", "required": ["token", "kind"], "additionalProperties": false,
              "properties": {"token": {"$ref": "#/$defs/token"},
                             "kind": {"enum": ["숫자", "글", "날짜", "범주", "참거짓"]},
                             "unit": {"enum": ["있음", "없음"]},
                             "count": {"type": "integer", "minimum": 0, "maximum": 99}}}
  }
}
